<UserControl x:Class="SharkBabyDrivers.Views.R5View" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:SharkBabyDrivers.Views" xmlns:l="clr-namespace:SharkBabyDrivers.Localization">
 <UserControl.Resources>
  <Style x:Key="R5Help" TargetType="Button" BasedOn="{StaticResource BaseButton}">
   <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
   <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="6,0,0,0"/>
   <Setter Property="Content" Value="!"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Foreground" Value="{StaticResource Accent}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="9">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{StaticResource AccentDim}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentDim}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
   <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
  </Style>
  <Style x:Key="R5Marker" TargetType="Button" BasedOn="{StaticResource BaseButton}">
   <Setter Property="Width" Value="52"/><Setter Property="Height" Value="52"/>
   <Setter Property="FontSize" Value="36"/>
   <Setter Property="Padding" Value="0"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Background" Value="#152E2A"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#E8E9A2"/><Setter Property="BorderThickness" Value="2"/>
  </Style>
        <Style x:Key="DpiFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Width="5" CornerRadius="2.5" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VerticalDpi" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="50"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SliderArea" Width="26" Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DpiFill}" Background="{StaticResource Accent}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DpiFill}" Background="{StaticResource Surface3}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SliderArea" Property="Background" Value="{StaticResource AccentDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
  <Style x:Key="R5Card" TargetType="Border" BasedOn="{StaticResource Card}">
   <Setter Property="Padding" Value="14"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
 </UserControl.Resources>
 <TabControl Margin="0,0,0,12">
  <TabItem Header="R5 Ultra">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" IsEnabled="{Binding CanWrite}">
     <TextBlock Text="{Binding ProfileLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock Text="Configure os botões à esquerda e a sensibilidade à direita." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
      <Border Style="{StaticResource R5Card}" VerticalAlignment="Top">
       <StackPanel>
        <TextBlock Text="R5 Ultra" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
      <Border Background="Transparent" CornerRadius="14" Padding="12" Margin="0,0,0,8" VerticalAlignment="Top">
       <Viewbox Height="320" Stretch="Uniform">
        <Canvas Width="455" Height="800">
         <Image Source="/SharkBabyDrivers;component/Assets/r5-ultra-transparent.png" Width="455" Height="800"/>
         <Button Content="1" Tag="0" Canvas.Left="112" Canvas.Top="115" Style="{StaticResource R5Marker}" ToolTip="1 · Clique esquerdo" AutomationProperties.Name="Selecionar botão 1: esquerdo" Click="SelectMouseButton"/>
         <Button Content="2" Tag="1" Canvas.Left="310" Canvas.Top="115" Style="{StaticResource R5Marker}" ToolTip="2 · Clique direito" AutomationProperties.Name="Selecionar botão 2: direito" Click="SelectMouseButton"/>
         <Button Content="3" Tag="2" Canvas.Left="212" Canvas.Top="132" Style="{StaticResource R5Marker}" ToolTip="3 · Clique do scroll" AutomationProperties.Name="Selecionar botão 3: scroll" Click="SelectMouseButton"/>
         <Button Content="4" Tag="3" Canvas.Left="10" Canvas.Top="386" Style="{StaticResource R5Marker}" ToolTip="4 · Lateral traseiro / voltar" AutomationProperties.Name="Selecionar botão 4: voltar" Click="SelectMouseButton"/>
         <Button Content="5" Tag="4" Canvas.Left="10" Canvas.Top="280" Style="{StaticResource R5Marker}" ToolTip="5 · Lateral dianteiro / avançar" AutomationProperties.Name="Selecionar botão 5: avançar" Click="SelectMouseButton"/>
        </Canvas>
       </Viewbox>
      </Border>
        <TextBlock Text="Clique nos números para configurar os botões." Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <StackPanel>
       <ComboBox x:Name="ButtonAssignments" ItemsSource="{Binding Buttons}" SelectedIndex="0" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding NumberedLabel}"/></DataTemplate></ComboBox.ItemTemplate>
       </ComboBox>
       <ContentControl Content="{Binding SelectedItem, ElementName=ButtonAssignments}">
        <ContentControl.ContentTemplate><DataTemplate>
         <StackPanel>
          <TextBlock Text="{Binding NumberedLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="Função do botão" Margin="0,0,0,8"/>
          <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Selected}"/>
          <Button Content="Definir atalho…" Command="{Binding ShortcutCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Current}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
         </StackPanel>
        </DataTemplate></ContentControl.ContentTemplate>
       </ContentControl>
      </StackPanel>
       </StackPanel>
      </Border>
                        <Border Style="{StaticResource R5Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,7">
                                    <Button DockPanel.Dock="Right" Command="{Binding NewProfileCommand}" Style="{StaticResource Ghost}"
                                            Content="{l:T profile_new}" Padding="6,4" MinHeight="24" FontSize="10.5" ToolTip="{l:T profile_new_hint}"/>
                                    <TextBlock Text="{l:T tab_profiles}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border CornerRadius="7" Padding="8,6" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedSavedProfile}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentDim}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ProfileEditorStatus}" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>
                                <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FontSize="11"
                                         Padding="8,6" Margin="0,0,0,7" ToolTip="{l:T profile_name_hint}"
                                         AutomationProperties.Name="{l:T name}"/>
                                <Button Command="{Binding SaveProfileCommand}" Content="{l:T profile_save}" Style="{StaticResource Primary}"
                                        FontSize="11" Padding="8,7" MinHeight="30" Margin="0,0,0,7"/>
                                <Button Command="{Binding ImportProfileCommand}" Content="{l:T profile_import}" Style="{StaticResource BaseButton}"
                                        HorizontalContentAlignment="Center" Margin="0,0,0,7"/>
                                <TextBlock Text="{l:T profile_inline_save_hint}" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,9"/>
                                <TextBlock Text="{l:T profiles_empty}" Style="{StaticResource Hint}" FontSize="10.5"
                                           Visibility="{Binding SavedProfiles.Count, Converter={StaticResource VisIfNot}}"/>
                                <ScrollViewer MaxHeight="114" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SavedProfiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Padding="7,6" Margin="0,0,0,3" MinHeight="29" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="{l:T profile_load}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentDim}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentSoft}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10"
                                                                   Foreground="{StaticResource Accent}" Margin="6,0,0,0"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource VisIf}}"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <Border Style="{StaticResource R5Card}"><StackPanel>
     <TextBlock Text="Sensibilidade DPI" FontSize="17" Margin="0,0,0,8"/>
     <TextBlock Text="50–42.000 · passos de 50. Desmarque X=Y para ajustar o eixo Y separadamente." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <ItemsControl ItemsSource="{Binding DpiStages}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Padding="3,8" Margin="2,0" CornerRadius="12" BorderThickness="1">
        <Border.Style><Style TargetType="Border">
         <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
         <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Background" Value="{StaticResource AccentDim}"/></DataTrigger></Style.Triggers>
        </Style></Border.Style>
        <StackPanel>
         <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
         <RadioButton Style="{StaticResource Dot}" IsChecked="{Binding IsActive, Mode=TwoWay}" ToolTip="Usar este estágio" HorizontalAlignment="Center" Margin="0,8"/>

         <Slider Style="{StaticResource VerticalDpi}" Minimum="50" Maximum="42000" SmallChange="50" LargeChange="500" Value="{Binding X}" Height="136" HorizontalAlignment="Center" AutomationProperties.Name="DPI X"/>
         <TextBox Text="{Binding X, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" FontSize="10" Padding="1,5" MinHeight="28" TextAlignment="Center" Margin="0,8,0,5" AutomationProperties.Name="Valor DPI X"/>
         <CheckBox Content="X=Y" FontSize="9" IsChecked="{Binding Linked}" ToolTip="Vincular os eixos X e Y" HorizontalAlignment="Center" Margin="0,4"/>
         <StackPanel Visibility="{Binding Linked, Converter={StaticResource VisIfNot}}">
          <TextBlock Text="Y" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
          <TextBox Text="{Binding Y, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" FontSize="10" Padding="1,5" TextAlignment="Center" AutomationProperties.Name="Valor DPI Y"/>
         </StackPanel>

        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="Clique em Aplicar no dispositivo para enviar o DPI e o estágio escolhido ao mouse." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
       </StackPanel></Border>
       <Border Style="{StaticResource R5Card}"><Expander Header="Sensor e desempenho" IsExpanded="True"><StackPanel Margin="0,12,0,0">
     <WrapPanel Margin="0,14,0,20">
      <StackPanel Width="145" Margin="0,0,18,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Polling" VerticalAlignment="Center"/><Button Style="{StaticResource R5Help}" Click="ShowSensorHelp" AutomationProperties.Name="Ajuda: Polling"><Button.ToolTip><ToolTip><TextBlock Text="Quantidade de vezes por segundo que o mouse envia dados ao computador. Mais Hz permitem atualizações mais frequentes, mas podem aumentar o uso de CPU e o consumo de bateria." TextWrapping="Wrap" MaxWidth="320"/></ToolTip></Button.ToolTip></Button></StackPanel><ComboBox ItemsSource="{Binding PollingChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Polling}" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Width="145"><StackPanel Orientation="Horizontal"><TextBlock Text="Distância LOD" VerticalAlignment="Center"/><Button Style="{StaticResource R5Help}" Click="ShowSensorHelp" AutomationProperties.Name="Ajuda: Distância LOD"><Button.ToolTip><ToolTip><TextBlock Text="Altura em que o sensor para de detectar movimento ao levantar o mouse da superfície. Um valor menor faz o cursor parar com o mouse mais próximo do mousepad." TextWrapping="Wrap" MaxWidth="320"/></ToolTip></Button.ToolTip></Button></StackPanel><ComboBox ItemsSource="{Binding LodChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Lod}" Margin="0,8,0,0"/></StackPanel>
     </WrapPanel>
     <WrapPanel Margin="0,0,0,18">
      <StackPanel Width="145" Margin="0,0,18,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Debounce (0–30 ms)" VerticalAlignment="Center"/><Button Style="{StaticResource R5Help}" Click="ShowSensorHelp" AutomationProperties.Name="Ajuda: Debounce (0–30 ms)"><Button.ToolTip><ToolTip><TextBlock Text="Tempo de filtragem dos cliques, em milissegundos. Valores menores reduzem a espera; valores maiores ajudam a evitar cliques duplos involuntários causados pelo contato do botão." TextWrapping="Wrap" MaxWidth="320"/></ToolTip></Button.ToolTip></Button></StackPanel><TextBox Text="{Binding Debounce, ValidatesOnExceptions=True}" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Width="145"><StackPanel Orientation="Horizontal"><TextBlock Text="Suspensão (segundos)" VerticalAlignment="Center"/><Button Style="{StaticResource R5Help}" Click="ShowSensorHelp" AutomationProperties.Name="Ajuda: Suspensão (segundos)"><Button.ToolTip><ToolTip><TextBlock Text="Tempo sem uso antes de o mouse entrar em suspensão para economizar energia. O valor 65535 desativa a suspensão automática." TextWrapping="Wrap" MaxWidth="320"/></ToolTip></Button.ToolTip></Button></StackPanel><TextBox Text="{Binding SleepSeconds, ValidatesOnExceptions=True}" Margin="0,8,0,0"/><TextBlock Text="65535 = nunca" Foreground="{StaticResource Muted}"/></StackPanel>
     </WrapPanel>
     <WrapPanel Margin="0,0,0,24"><StackPanel Orientation="Horizontal" Margin="0,0,18,10"><CheckBox Content="Correção de linhas" IsChecked="{Binding AngleSnap}" VerticalAlignment="Center"/><Button Style="{StaticResource R5Help}" Click="ShowSensorHelp" AutomationProperties.Name="Ajuda: Correção de linhas"><Button.ToolTip><ToolTip><TextBlock Text="Angle snap: corrige pequenos desvios para deixar o movimento mais reto. Pode ajudar a desenhar linhas, mas altera o movimento natural da mão." TextWrapping="Wrap" MaxWidth="320"/></ToolTip></Button.ToolTip></Button></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,18,10"><CheckBox Content="Sincronização do sensor" IsChecked="{Binding MotionSync}" VerticalAlignment="Center"/><Button Style="{StaticResource R5Help}" Click="ShowSensorHelp" AutomationProperties.Name="Ajuda: Sincronização do sensor"><Button.ToolTip><ToolTip><TextBlock Text="Motion Sync: sincroniza as leituras do sensor com o envio de dados ao computador, buscando intervalos mais regulares entre as atualizações de movimento." TextWrapping="Wrap" MaxWidth="320"/></ToolTip></Button.ToolTip></Button></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,18,10"><CheckBox Content="Redução de tremores" IsChecked="{Binding Ripple}" VerticalAlignment="Center"/><Button Style="{StaticResource R5Help}" Click="ShowSensorHelp" AutomationProperties.Name="Ajuda: Redução de tremores"><Button.ToolTip><ToolTip><TextBlock Text="Ripple control: filtra pequenas oscilações do sensor, especialmente em DPI alto. Deixa o movimento mais suave, mas pode reduzir a percepção de movimentos muito pequenos." TextWrapping="Wrap" MaxWidth="320"/></ToolTip></Button.ToolTip></Button></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,18,10"><CheckBox Content="Modo de rastreamento" IsChecked="{Binding Tracking}" VerticalAlignment="Center"/><Button Style="{StaticResource R5Help}" Click="ShowSensorHelp" AutomationProperties.Name="Ajuda: Modo de rastreamento"><Button.ToolTip><ToolTip><TextBlock Text="Tracking mode: ativa o ajuste de rastreamento oferecido pelo firmware do R5 Ultra. O efeito exato desse modo ainda não foi confirmado neste driver; não há garantia de melhora na precisão ou na latência." TextWrapping="Wrap" MaxWidth="320"/></ToolTip></Button.ToolTip></Button></StackPanel></WrapPanel>
       </StackPanel></Expander></Border>
      </StackPanel>
     </Grid>
     <TextBlock Text="O backup cobre os ajustes desta tela e as atribuições dos botões do perfil ativo. Macros existentes são preservadas; edição de macros e cores DPI ainda não disponível. Para outro perfil, selecione-o no mouse e releia o dispositivo." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>
  <TabItem Header="Salvos e backup"><ScrollViewer VerticalScrollBarVisibility="Auto"><v:BackupPanel Margin="24"/></ScrollViewer></TabItem>
 </TabControl>
</UserControl>
