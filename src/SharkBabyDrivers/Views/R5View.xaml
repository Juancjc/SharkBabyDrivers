<UserControl x:Class="SharkBabyDrivers.Views.R5View" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:SharkBabyDrivers.Views">
 <TabControl Margin="0,0,0,12">
  <TabItem Header="R5 Ultra">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" IsEnabled="{Binding CanWrite}">
     <TextBlock Text="{Binding ProfileLabel}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock Text="Integração baseada no programa oficial. Validação no mouse físico pendente." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <TextBlock Text="DPI por estágio • 50–42000, passos de 50" FontSize="17" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding DpiStages}"><ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="{Binding Label}" Width="90" VerticalAlignment="Center"/><TextBlock Text="X" Margin="8"/><TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100"/><TextBlock Text="Y" Margin="8"/><TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100"/></StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <WrapPanel Margin="0,14,0,20">
      <StackPanel Width="160" Margin="0,0,18,0"><TextBlock Text="Estágio ativo (1–6)"/><TextBox Text="{Binding ActiveDpi, ValidatesOnExceptions=True}" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Width="160" Margin="0,0,18,0"><TextBlock Text="Polling"/><ComboBox ItemsSource="{Binding PollingChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Polling}" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Width="160"><TextBlock Text="Distância LOD"/><ComboBox ItemsSource="{Binding LodChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Lod}" Margin="0,8,0,0"/></StackPanel>
     </WrapPanel>
     <WrapPanel Margin="0,0,0,18">
      <StackPanel Width="160" Margin="0,0,18,0"><TextBlock Text="Debounce (0–30 ms)"/><TextBox Text="{Binding Debounce, ValidatesOnExceptions=True}" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Width="200"><TextBlock Text="Suspensão (segundos)"/><TextBox Text="{Binding SleepSeconds, ValidatesOnExceptions=True}" Margin="0,8,0,0"/><TextBlock Text="65535 = nunca" Foreground="{StaticResource Muted}"/></StackPanel>
     </WrapPanel>
     <WrapPanel Margin="0,0,0,24"><CheckBox Content="Angle snap" IsChecked="{Binding AngleSnap}" Margin="0,0,20,0"/><CheckBox Content="Motion Sync" IsChecked="{Binding MotionSync}" Margin="0,0,20,0"/><CheckBox Content="Ripple control" IsChecked="{Binding Ripple}" Margin="0,0,20,0"/><CheckBox Content="Tracking mode" IsChecked="{Binding Tracking}"/></WrapPanel>
     <TextBlock Text="Botões" FontSize="17" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding Buttons}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="{Binding Label}" Width="120" VerticalAlignment="Center"/><ComboBox Width="240" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Selected}"/><Button Content="Atalho…" Command="{Binding ShortcutCommand}" Margin="8,0,0,0"/><TextBlock Text="{Binding Current}" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="O backup cobre os ajustes desta tela e as atribuições dos botões do perfil ativo. Macros existentes são preservadas; edição de macros e cores DPI ainda não disponível. Para outro perfil, selecione-o no mouse e releia o dispositivo." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>
  <TabItem Header="Salvos e backup"><ScrollViewer VerticalScrollBarVisibility="Auto"><v:BackupPanel Margin="24"/></ScrollViewer></TabItem>
 </TabControl>
</UserControl>
