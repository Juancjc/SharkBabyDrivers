<UserControl x:Class="SharkBabyDrivers.Views.BackupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SharkBabyDrivers.Localization"
             xmlns:vm="clr-namespace:SharkBabyDrivers.ViewModels">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l:T backup_title}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T backup_text}" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                <WrapPanel>
                    <Button Command="{Binding BackupNowCommand}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T backup_now}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ImportBackupCommand}" Content="{l:T backup_import}" Margin="0,0,8,8"/>
                    <Button Command="{Binding OpenBackupFolderCommand}" Content="{l:T open_backups}" Margin="0,0,8,8"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <TextBlock Text="{l:T backup_list_empty}" Style="{StaticResource Hint}"
                           Visibility="{Binding BackupList.Count, Converter={StaticResource VisIfNot}}"/>
                <ItemsControl ItemsSource="{Binding BackupList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BackupItemVm}">
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{l:T backup_export}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.ExportBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="{l:T backup_restore}"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding When}" FontWeight="SemiBold"/>
                                            <Border CornerRadius="5" Background="{StaticResource AccentDim}" Padding="7,1" Margin="10,0,0,0"
                                                    Visibility="{Binding IsOriginal, Converter={StaticResource VisIf}}">
                                                <TextBlock Text="{l:T backup_original}" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,3,12,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{l:T factory_reset}" Command="{Binding FactoryResetCommand}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{l:T profile_export}" Command="{Binding ExportProfileCommand}" Margin="0,0,8,0"/>
                    <Button Content="{l:T profile_import}" Command="{Binding ImportProfileCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
