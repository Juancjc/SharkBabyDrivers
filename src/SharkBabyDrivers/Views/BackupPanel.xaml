<UserControl x:Class="SharkBabyDrivers.Views.BackupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SharkBabyDrivers.Localization"
             xmlns:vm="clr-namespace:SharkBabyDrivers.ViewModels">
    <StackPanel>
        <!-- ============ saved profiles ============ -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l:T profiles_title}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T profiles_text}" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Command="{Binding SaveProfileCommand}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T profile_save}"/>
                        </StackPanel>
                    </Button>
                    <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                             ToolTip="{l:T profile_name_hint}"/>
                </DockPanel>
                <WrapPanel>
                    <Button Content="{l:T profile_import}" Command="{Binding ImportProfileCommand}" Margin="0,0,8,8"/>
                    <Button Content="{l:T profile_export}" Command="{Binding ExportProfileCommand}" Margin="0,0,8,8"/>
                </WrapPanel>

                <TextBlock Text="{l:T profiles_empty}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Visibility="{Binding SavedProfiles.Count, Converter={StaticResource VisIfNot}}"/>
                <ItemsControl ItemsSource="{Binding SavedProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SavedProfileVm}">
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{l:T profile_load}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="{l:T profile_delete}"
                                                Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Hint}" Margin="0,2,12,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============ original backup ============ -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l:T backup_title}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T backup_text}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                <TextBlock Text="{l:T backup_list_empty}" Style="{StaticResource Hint}"
                           Visibility="{Binding BackupList.Count, Converter={StaticResource VisIfNot}}"/>
                <ItemsControl ItemsSource="{Binding BackupList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BackupItemVm}">
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{l:T backup_export}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.ExportBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="{l:T backup_restore}"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding When}" FontWeight="SemiBold"/>
                                            <Border CornerRadius="5" Background="{StaticResource AccentDim}" Padding="7,1" Margin="10,0,0,0">
                                                <TextBlock Text="{l:T backup_original}" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,3,12,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Command="{Binding OpenBackupFolderCommand}" Content="{l:T open_backups}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{l:T factory_reset}" Command="{Binding FactoryResetCommand}" VerticalAlignment="Center"/>
                <TextBlock Text="{l:T factory_reset_hint}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
