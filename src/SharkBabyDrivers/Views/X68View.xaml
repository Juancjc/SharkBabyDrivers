<UserControl x:Class="SharkBabyDrivers.Views.X68View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SharkBabyDrivers.Localization"
             xmlns:vm="clr-namespace:SharkBabyDrivers.ViewModels"
             xmlns:c="clr-namespace:SharkBabyDrivers.Controls"
             xmlns:v="clr-namespace:SharkBabyDrivers.Views">
    <UserControl.Resources>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- One key cap -->
        <Style x:Key="Cap" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="7" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <Grid Margin="5,3">
                                <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Mapping}" FontSize="10.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding HeBadge}" FontSize="9" Foreground="{StaticResource Warn}" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#8A3A40"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDim}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The keyboard drawing (shared by the Keys and Hall Effect tabs) -->
        <DataTemplate x:Key="Board">
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                <Border Background="{StaticResource Sidebar}" CornerRadius="14" Padding="14" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding Caps}" Width="{Binding BoardWidth}" Height="{Binding BoardHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KeyCapVm}">
                                <Button Style="{StaticResource Cap}" Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Mapping}"
                                        Command="{Binding DataContext.SelectKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Viewbox>
        </DataTemplate>

        <!-- Profile selector -->
        <DataTemplate x:Key="ProfileBar">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="{l:T kb_activate_profile}" Command="{Binding ActivateProfileCommand}"/>
                <TextBlock Text="{l:T kb_profile}" Style="{StaticResource Label}" Margin="0,0,10,0"/>
                <ItemsControl ItemsSource="{Binding ProfileChoices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" Padding="16,6" GroupName="kbprofile"
                                         Command="{Binding DataContext.SetEditProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Mode="OneWay" Converter="{x:Static v:MultiEquals.Instance}">
                                        <Binding Path="Value"/>
                                        <Binding Path="DataContext.EditProfile" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ActiveProfileText}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
        </DataTemplate>

        <!-- Function picker (used by remap, MT, TGL and DKS bindings) -->
        <DataTemplate x:Key="ActionEditor">
            <StackPanel>
                <ComboBox ItemsSource="{Binding RemapKinds}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RemapKind}" Margin="0,0,0,8"/>
                <StackPanel Visibility="{Binding RemapKind, Converter={StaticResource VisIf}, ConverterParameter=Key}">
                    <ComboBox ItemsSource="{Binding KeyChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RemapKey}" IsTextSearchEnabled="True" TextSearch.TextPath="Label"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="{l:T kb_modifiers}" Style="{StaticResource Label}" Margin="0,0,10,0"/>
                        <CheckBox Content="Ctrl" IsChecked="{Binding ModCtrl}" Margin="0,0,12,0"/>
                        <CheckBox Content="Shift" IsChecked="{Binding ModShift}" Margin="0,0,12,0"/>
                        <CheckBox Content="Alt" IsChecked="{Binding ModAlt}" Margin="0,0,12,0"/>
                        <CheckBox Content="Win" IsChecked="{Binding ModWin}"/>
                    </WrapPanel>
                </StackPanel>
                <ComboBox Visibility="{Binding RemapKind, Converter={StaticResource VisIf}, ConverterParameter=Mouse}"
                          ItemsSource="{Binding MouseChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RemapMouse}"/>
                <ComboBox Visibility="{Binding RemapKind, Converter={StaticResource VisIf}, ConverterParameter=Media}"
                          ItemsSource="{Binding MediaChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RemapMedia}"/>
                <ComboBox Visibility="{Binding RemapKind, Converter={StaticResource VisIf}, ConverterParameter=System}"
                          ItemsSource="{Binding SystemChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RemapSystem}"/>
                <StackPanel Visibility="{Binding RemapKind, Converter={StaticResource VisIf}, ConverterParameter=Macro}">
                    <DockPanel>
                        <TextBlock Text="{l:T kmacro_index}" Style="{StaticResource Label}" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding RemapMacro, Converter={x:Static v:PlusOne.Instance}}" Width="60" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <ComboBox ItemsSource="{Binding MacroModes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RemapMacroMode}" Margin="0,8,0,0"/>
                </StackPanel>
                <ComboBox Visibility="{Binding RemapKind, Converter={StaticResource VisIf}, ConverterParameter=Profile}"
                          ItemsSource="{Binding ProfileChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RemapProfile}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl Margin="32,0,32,0" IsEnabled="{Binding IsReady}">
        <!-- ============================== KEYS ============================== -->
        <TabItem Header="{l:T tab_keys}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileBar}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{l:T kb_layer}" Style="{StaticResource Label}" Margin="0,0,10,0"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{l:T layer_Base}" IsChecked="{Binding Layer, Converter={StaticResource Eq}, ConverterParameter=Base}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{l:T layer_FnWin}" IsChecked="{Binding Layer, Converter={StaticResource Eq}, ConverterParameter=FnWin}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{l:T layer_FnMac}" IsChecked="{Binding Layer, Converter={StaticResource Eq}, ConverterParameter=FnMac}"/>
                    </StackPanel>
                    <TextBlock Text="{l:T kb_editing_inactive}" Style="{StaticResource Hint}" Foreground="{StaticResource Warn}" Margin="0,0,0,8"
                               Visibility="{Binding IsEditingActive, Converter={StaticResource VisIfNot}}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Board}" Margin="0,0,0,14"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FocusKeyName}" Style="{StaticResource H1}" FontSize="22"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">
                                    <Run Text="{l:T kb_current}"/>: <Run Text="{Binding FocusCurrentText, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
                                </TextBlock>
                                <TextBlock Text="{l:T kb_select_hint}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" MaxWidth="460" HorizontalAlignment="Left">
                                <TextBlock Text="{l:T kb_new_action}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActionEditor}"/>
                                <Button Style="{StaticResource Primary}" Content="{l:T kb_assign}" Command="{Binding AssignCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================== HALL EFFECT ============================== -->
        <TabItem Header="{l:T tab_hall}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileBar}"/>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:T kb_select_all}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                            <Button Content="{l:T kb_select_none}" Command="{Binding SelectNoneCommand}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{Binding SelectedCount, Converter={StaticResource Fmt}, ConverterParameter='{}{0} ✓'}"/>
                    </DockPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Board}" Margin="0,0,0,14"/>

                    <TextBlock Text="{l:T kb_he_profile_locked}" Style="{StaticResource Hint}" Foreground="{StaticResource Warn}" Margin="0,0,0,8"
                               Visibility="{Binding HeLocked, Converter={StaticResource VisIf}}"/>
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding HeEditable}">
                        <StackPanel>
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource BaseButton}" IsChecked="{Binding Calibrating, Mode=OneWay}" Command="{Binding CalibrateCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{l:T calibrate}" Visibility="{Binding Calibrating, Converter={StaticResource VisIfNot}}"/>
                                        <TextBlock Text="{l:T calibrate_stop}" Visibility="{Binding Calibrating, Converter={StaticResource VisIf}}"/>
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Text="{l:T he_title}" Style="{StaticResource H2}"/>
                            </DockPanel>
                            <TextBlock Text="{l:T calibrate_running}" Foreground="{StaticResource Warn}" Visibility="{Binding Calibrating, Converter={StaticResource VisIf}}"/>
                            <TextBlock Text="{l:T he_hint}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:T he_mode}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding KeyModes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding HeMode}"/>

                                    <StackPanel Visibility="{Binding IsTravelMode, Converter={StaticResource VisIf}}">
                                        <TextBlock Text="{l:T he_actuation}" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Actuation, StringFormat={}{0:0.00} mm}"/>
                                            <Slider Minimum="0.1" Maximum="{Binding TravelMax}" SmallChange="{Binding TravelStep}" LargeChange="0.1" Value="{Binding Actuation, Delay=200}"/>
                                        </DockPanel>
                                        <TextBlock Text="{l:T he_release}" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding ReleasePoint, StringFormat={}{0:0.00} mm}"/>
                                            <Slider Minimum="0.1" Maximum="{Binding TravelMax}" SmallChange="{Binding TravelStep}" LargeChange="0.1" Value="{Binding ReleasePoint, Delay=200}"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <DockPanel Margin="0,16,0,0">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding RapidTrigger}"/>
                                        <StackPanel>
                                            <TextBlock Text="{l:T he_rt}" Style="{StaticResource Label}"/>
                                            <TextBlock Text="{l:T he_rt_hint}" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Visibility="{Binding RapidTrigger, Converter={StaticResource VisIf}}">
                                        <TextBlock Text="{l:T he_rt_press}" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding RtPress, StringFormat={}{0:0.00} mm}"/>
                                            <Slider Minimum="0.01" Maximum="2" SmallChange="{Binding TravelStep}" LargeChange="0.05" Value="{Binding RtPress, Delay=200}"/>
                                        </DockPanel>
                                        <TextBlock Text="{l:T he_rt_release}" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding RtRelease, StringFormat={}{0:0.00} mm}"/>
                                            <Slider Minimum="0.01" Maximum="2" SmallChange="{Binding TravelStep}" LargeChange="0.05" Value="{Binding RtRelease, Delay=200}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:T he_bottom_dz}" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding BottomDeadZone, StringFormat={}{0:0.00} mm}"/>
                                        <Slider Minimum="0" Maximum="1" SmallChange="{Binding TravelStep}" LargeChange="0.05" Value="{Binding BottomDeadZone, Delay=200}"/>
                                    </DockPanel>
                                    <StackPanel Visibility="{Binding HasTopDeadZone, Converter={StaticResource VisIf}}">
                                        <TextBlock Text="{l:T he_top_dz}" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding TopDeadZone, StringFormat={}{0:0.00} mm}"/>
                                            <Slider Minimum="0" Maximum="1" SmallChange="{Binding TravelStep}" LargeChange="0.05" Value="{Binding TopDeadZone, Delay=200}"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <TextBlock Text="{l:T he_switch}" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                                    <ComboBox ItemsSource="{Binding SwitchChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SwitchType}"/>

                                    <!-- Mod-Tap -->
                                    <StackPanel Visibility="{Binding IsModTap, Converter={StaticResource VisIf}}" Margin="0,14,0,0">
                                        <TextBlock Text="{l:T he_mt_time}" Style="{StaticResource Label}"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding MtTimeMs, StringFormat={}{0} ms}"/>
                                            <Slider Minimum="50" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding MtTimeMs, Delay=200}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right" Content="{l:T he_set_from_editor}" Command="{Binding SetMtHoldCommand}"/>
                                            <TextBlock Style="{StaticResource Label}"><Run Text="{l:T he_mt_hold}"/>: <Run Text="{Binding MtHoldText, Mode=OneWay}" Foreground="{StaticResource Accent}"/></TextBlock>
                                        </DockPanel>
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right" Content="{l:T he_set_from_editor}" Command="{Binding SetMtTapCommand}"/>
                                            <TextBlock Style="{StaticResource Label}"><Run Text="{l:T he_mt_tap}"/>: <Run Text="{Binding MtTapText, Mode=OneWay}" Foreground="{StaticResource Accent}"/></TextBlock>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Toggle -->
                                    <DockPanel Visibility="{Binding IsToggle, Converter={StaticResource VisIf}}" Margin="0,14,0,0">
                                        <Button DockPanel.Dock="Right" Content="{l:T he_set_from_editor}" Command="{Binding SetToggleCommand}"/>
                                        <TextBlock Style="{StaticResource Label}"><Run Text="{l:T he_toggle_action}"/>: <Run Text="{Binding MtHoldText, Mode=OneWay}" Foreground="{StaticResource Accent}"/></TextBlock>
                                    </DockPanel>

                                    <!-- Snap tap -->
                                    <StackPanel Visibility="{Binding IsSnap, Converter={StaticResource VisIf}}" Margin="0,14,0,0">
                                        <TextBlock Text="{l:T he_snap_partner}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding SnapChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SnapPartner}"/>
                                        <TextBlock Text="{l:T he_snap_hint}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- DKS -->
                            <StackPanel Visibility="{Binding IsDks, Converter={StaticResource VisIf}}" Margin="0,18,0,0">
                                <TextBlock Text="{l:T he_dks_travel}" Style="{StaticResource Label}"/>
                                <DockPanel MaxWidth="520" HorizontalAlignment="Left" Width="520">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding DksTravel, StringFormat={}{0:0.00} mm}"/>
                                    <Slider Minimum="0.1" Maximum="{Binding TravelMax}" SmallChange="{Binding TravelStep}" LargeChange="0.1" Value="{Binding DksTravel, Delay=200}"/>
                                </DockPanel>
                                <TextBlock Text="{l:T he_dks_hint}" Style="{StaticResource Hint}" Margin="0,8,0,8"/>
                                <TextBlock Text="{l:T he_dks_phases}" Foreground="{StaticResource Muted}" Margin="250,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding DksBindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DksBindingVm}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ActionText}" Style="{StaticResource Label}" Foreground="{StaticResource Accent}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <ComboBox Width="150" Margin="0,0,6,0" ItemsSource="{Binding DataContext.DksPhaseChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding P0}"/>
                                                    <ComboBox Width="150" Margin="0,0,6,0" ItemsSource="{Binding DataContext.DksPhaseChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding P1}"/>
                                                    <ComboBox Width="150" Margin="0,0,6,0" ItemsSource="{Binding DataContext.DksPhaseChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding P2}"/>
                                                    <ComboBox Width="150" Margin="0,0,6,0" ItemsSource="{Binding DataContext.DksPhaseChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding P3}"/>
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="{l:T he_set_from_editor}" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.SetDksBindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Index}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================== LIGHTING ============================== -->
        <TabItem Header="{l:T tab_lighting}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
                <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T light_now_title}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding LightNow.Effect}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding LightNow.Detail}" Style="{StaticResource Hint}" Margin="0,2,0,12"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <c:X68LightBoard Model="{Binding Model}" State="{Binding LightPreview}"/>
                        </Viewbox>
                        <TextBlock Text="{l:T light_now_sim_hint}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        <TextBlock Text="{l:T light_now_pending}" Style="{StaticResource Hint}" Foreground="{StaticResource Warn}" Margin="0,6,0,0"
                                   Visibility="{Binding LightPending, Converter={StaticResource VisIf}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T light_owner_title}" Style="{StaticResource H2}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                            <RadioButton Style="{StaticResource Segment}" GroupName="lightowner" Content="{l:T light_owner_app}" IsChecked="{Binding LightingByApp}"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="lightowner" Content="{l:T light_owner_signal}" IsChecked="{Binding LightingBySignalRgb}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LightingStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="{l:T light_owner_hint}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T signal_plugin_install}" Command="{Binding InstallSignalRgbPluginCommand}"/>
                            <TextBlock Text="{Binding SignalRgbPluginText}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T capture_title}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{l:T capture_text}" Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CaptureStaticPictureCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:T capture_button}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{l:T capture_slot}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding CaptureSlotChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding CaptureSlot}"
                                      MinWidth="110" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding CaptureStatusText}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{l:T light_locked}" Style="{StaticResource Hint}" Foreground="{StaticResource Warn}" Margin="4,0,0,8"
                           Visibility="{Binding LightingBySignalRgb, Converter={StaticResource VisIf}}"/>
                <Border Style="{StaticResource Card}" IsEnabled="{Binding LightingEditable}">
                    <StackPanel>
                        <TextBlock Text="{l:T light_title}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{l:T light_mode}" Style="{StaticResource Label}" Margin="0,10,0,6"/>
                        <ItemsControl ItemsSource="{Binding LightModes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" Margin="0,0,6,6" GroupName="kblight"
                                                 Command="{Binding DataContext.SetLightModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Mode="OneWay" Converter="{x:Static v:MultiEquals.Instance}">
                                                <Binding Path="Value"/>
                                                <Binding Path="DataContext.LightMode" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding HasLightOptions, Converter={StaticResource VisIf}}" Margin="0,12,0,0">
                            <TextBlock Text="{l:T light_variant}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding LightOptionChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding LightOption}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasLightColor, Converter={StaticResource VisIf}}" Margin="0,14,0,0">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding LightRainbow}"/>
                                <TextBlock Text="{l:T light_rainbow}" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <DockPanel Margin="0,10,0,0" Visibility="{Binding LightRainbow, Converter={StaticResource VisIfNot}}">
                                <c:ColorButton DockPanel.Dock="Right" Color="{Binding LightColor}"/>
                                <TextBlock Text="{l:T light_color}" Style="{StaticResource Label}"/>
                            </DockPanel>
                        </StackPanel>
                        <TextBlock Text="{l:T brightness}" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding LightBrightness, StringFormat={}{0} / 4}"/>
                            <Slider Minimum="0" Maximum="4" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding LightBrightness}"/>
                        </DockPanel>
                        <StackPanel Visibility="{Binding HasLightSpeed, Converter={StaticResource VisIf}}" Margin="0,16,0,0">
                            <TextBlock Text="{l:T speed}" Style="{StaticResource Label}"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding LightSpeed, StringFormat={}{0} / 4}"/>
                                <Slider Minimum="0" Maximum="4" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding LightSpeed}"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================== OPTIONS ============================== -->
        <TabItem Header="{l:T tab_performance}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T polling_title}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{l:T kb_polling_hint}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding PollingChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" Margin="0,0,6,6" GroupName="kbpoll"
                                                     Command="{Binding DataContext.SetPollingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Mode="OneWay" Converter="{x:Static v:MultiEquals.Instance}">
                                                    <Binding Path="Value"/>
                                                    <Binding Path="DataContext.PollingHz" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T kb_options_title}" Style="{StaticResource H2}"/>
                            <DockPanel Margin="0,10,0,0">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoOs}"/>
                                <TextBlock Text="{l:T kb_auto_os}" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"><Run Text="{l:T kb_os}"/>: <Run Text="{Binding OsText, Mode=OneWay}"/></TextBlock>
                            <DockPanel Margin="0,12,0,0">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AntiMistouch}"/>
                                <TextBlock Text="{l:T kb_anti_mistouch}" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <DockPanel Margin="0,12,0,0">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding WasdSwap}"/>
                                <TextBlock Text="{l:T kb_wasd_swap}" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <TextBlock Text="{l:T kb_rt_stability}" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding RtStability}"/>
                                <Slider Minimum="0" Maximum="125" TickFrequency="25" IsSnapToTickEnabled="True" Value="{Binding RtStability}"/>
                            </DockPanel>
                            <TextBlock Text="{l:T kb_debounce}" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Debounce}"/>
                                <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Debounce}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T power_title}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{l:T kb_sleep}" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding SleepMinutes, StringFormat={}{0:0.#} min}"/>
                                <Slider Minimum="0" Maximum="60" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding SleepMinutes, Delay=200}"/>
                            </DockPanel>
                            <TextBlock Text="{l:T kb_deep_sleep}" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding DeepSleepMinutes, StringFormat={}{0:0.#} min}"/>
                                <Slider Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DeepSleepMinutes, Delay=200}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================== MACROS ============================== -->
        <TabItem Header="{l:T tab_macros}">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{l:T macro_new}" Command="{Binding NewMacroCommand}" Margin="0,0,6,0"/>
                            <Button Content="{l:T delete}" Command="{Binding DeleteMacroCommand}" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" ItemContainerStyle="{StaticResource PlainItem}" DisplayMemberPath="Name"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid>
                        <TextBlock Text="{l:T macro_none}" Style="{StaticResource Hint}" Visibility="{Binding SelectedMacro, Converter={StaticResource VisIfNot}}"/>
                        <DockPanel DataContext="{Binding SelectedMacro}" Visibility="{Binding Converter={StaticResource VisIf}}">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="{l:T kb_macros_hint}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{l:T macro_repeat}" Style="{StaticResource Label}" Width="110"/>
                                    <TextBox Text="{Binding Repeat}" Width="80" HorizontalAlignment="Left" LostFocus="Repeat_LostFocus"/>
                                </DockPanel>
                                <WrapPanel Margin="0,4,0,10">
                                    <ToggleButton Style="{StaticResource BaseButton}" Margin="0,0,8,0" Checked="Record_Checked" Unchecked="Record_Unchecked">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource Danger}" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="RecordText" Text="{l:T macro_record}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button Content="{l:T macro_clear}" Command="{Binding DataContext.ClearMacroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </WrapPanel>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Steps}" ItemContainerStyle="{StaticResource PlainItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:X68StepVm}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding KeyName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ActionName}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Text="{Binding DelayMs}" Width="90" HorizontalAlignment="Left" LostFocus="Repeat_LostFocus"/>
                                            <Button Grid.Column="3" Style="{StaticResource Ghost}" Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============================== BACKUP ============================== -->
        <TabItem Header="{l:T tab_backup}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
                <v:BackupPanel/>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
