<Window x:Class="SharkBabyDrivers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SharkBabyDrivers.Localization"
        xmlns:vm="clr-namespace:SharkBabyDrivers.ViewModels"
        xmlns:v="clr-namespace:SharkBabyDrivers.Views"
        Title="SharkBabyDrivers" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:X11Vm}"><v:X11View/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:X68Vm}"><v:X68View/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UnsupportedDeviceVm}"><v:UnsupportedView/></DataTemplate>

        <!-- Shared frame of every device page -->
        <DataTemplate x:Key="DeviceShell" DataType="{x:Type vm:DeviceVm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Margin="32,26,32,14">
                    <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="14" Background="{StaticResource AccentDim}" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Background="{StaticResource Surface}" Padding="12,6" Margin="0,0,8,0"
                                Visibility="{Binding Battery, Converter={StaticResource VisIf}, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE83F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding BatteryText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Background="{StaticResource Surface}" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:T firmware}" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding FirmwareText, FallbackValue='—'}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
                        <TextBlock Foreground="{StaticResource Muted}" Margin="0,2,0,0">
                            <Run Text="{Binding KindText, Mode=OneWay}"/> · <Run Text="{Binding LinkText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Status banner: reading / waking / error / backup gate -->
                <StackPanel Grid.Row="1" Margin="32,0,32,8">
                    <Border CornerRadius="10" Padding="14,10" Background="{StaticResource AccentDim}"
                            Visibility="{Binding IsLoading, Converter={StaticResource VisIf}}">
                        <DockPanel>
                            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="70" Height="4" Margin="0,0,12,0" Foreground="{StaticResource Accent}" Background="{StaticResource Surface3}" BorderThickness="0"/>
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <Border CornerRadius="10" Padding="14,10" Background="#3A2412"
                            Visibility="{Binding HasError, Converter={StaticResource VisIf}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T retry}" Command="{Binding RetryCommand}"/>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border CornerRadius="10" Padding="14,10" Background="#3A2412" Margin="0,6,0,0"
                            Visibility="{Binding State, Converter={StaticResource VisIf}, ConverterParameter=WaitingWake}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T retry}" Command="{Binding RetryCommand}"/>
                            <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" Margin="0,0,10,0"/>
                            <TextBlock Text="{l:T wake_hint}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Device-specific page -->
                <ContentControl Grid.Row="2" Content="{Binding}" Focusable="False"/>

                <!-- Apply bar -->
                <Border Grid.Row="3" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="32,12"
                        Visibility="{Binding IsReady, Converter={StaticResource VisIf}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:T discard}" Command="{Binding DiscardCommand}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource Primary}" Command="{Binding ApplyCommand}" Padding="22,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Foreground="White" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:T apply}" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Warn}" Margin="0,0,8,0" Visibility="{Binding IsDirty, Converter={StaticResource VisIf}}"/>
                            <TextBlock Text="{l:T pending_changes}" Foreground="{StaticResource Warn}" Visibility="{Binding IsDirty, Converter={StaticResource VisIf}}"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Toast -->
                <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" CornerRadius="10"
                        Background="{StaticResource Surface3}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16,10"
                        Visibility="{Binding Toast, Converter={StaticResource VisIf}}" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Success}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Toast}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="40" Height="40" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SharkBabyDrivers" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T app_tagline}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{l:T language}" Foreground="{StaticResource Muted}" FontSize="12" Margin="6,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Value" DisplayMemberPath="Label"
                              SelectedValue="{Binding Language}" Margin="0,0,0,10"/>
                    <Button Command="{Binding OpenBackupsCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="{l:T open_backups}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="{l:T refresh}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="{StaticResource Muted}" FontSize="11" Margin="6,12,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="{l:T devices}" Foreground="{StaticResource Muted}" FontSize="12" Margin="6,0,0,8"/>
                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DeviceVm}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Background="{StaticResource Surface3}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="19" HorizontalAlignment="Center"/>
                                </Border>
                                <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" Visibility="{Binding IsReady, Converter={StaticResource VisIf}}"/>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Visibility="{Binding IsLoading, Converter={StaticResource VisIf}}"/>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Warn}" Visibility="{Binding HasError, Converter={StaticResource VisIf}}"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
                                        <Run Text="{Binding KindText, Mode=OneWay}"/> · <Run Text="{Binding LinkText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding Selected}" ContentTemplate="{StaticResource DeviceShell}" Focusable="False"
                        Visibility="{Binding HasDevices, Converter={StaticResource VisIf}}"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding HasDevices, Converter={StaticResource VisIfNot}}">
            <TextBlock Text="&#xE88E;" Style="{StaticResource Icon}" FontSize="52" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <TextBlock Text="{l:T no_devices_title}" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
            <TextBlock Text="{l:T no_devices_text}" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>
