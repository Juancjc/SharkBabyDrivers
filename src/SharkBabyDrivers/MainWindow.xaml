<Window x:Class="SharkBabyDrivers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SharkBabyDrivers.Localization"
        xmlns:vm="clr-namespace:SharkBabyDrivers.ViewModels"
        xmlns:v="clr-namespace:SharkBabyDrivers.Views"
        Title="SharkBabyDrivers" Width="1320" Height="850" MinWidth="1040" MinHeight="680"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:X11Vm}"><v:X11View/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:X68Vm}"><v:X68View/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UnsupportedDeviceVm}"><v:UnsupportedView/></DataTemplate>

        <DataTemplate x:Key="DeviceShell" DataType="{x:Type vm:DeviceVm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="32,26,32,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:T shell_workspace}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentDim}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1" Margin="0,0,14,0">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="24" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding KindText}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    <TextBlock Text=" / " Foreground="{StaticResource Border}" Margin="6,0"/>
                                    <TextBlock Text="{Binding LinkText}" Foreground="{StaticResource TextSoft}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Border CornerRadius="6" Background="{StaticResource Surface2}" Padding="9,4" Margin="0,0,8,0"
                                    Visibility="{Binding Battery, Converter={StaticResource VisIf}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE83F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding BatteryText}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsReady, Converter={StaticResource VisIf}}">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{l:T shell_connected}" FontSize="11" Foreground="{StaticResource TextSoft}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding FirmwareText, FallbackValue='—'}" Foreground="{StaticResource Muted}" FontSize="11" MaxWidth="230" ToolTip="{l:T firmware}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="32,0,32,10">
                    <Border CornerRadius="12" Padding="16,12" Background="{StaticResource AccentDim}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1"
                            Visibility="{Binding IsLoading, Converter={StaticResource VisIf}}">
                        <DockPanel>
                            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="56" Height="3" Margin="0,0,14,0" Foreground="{StaticResource Accent}" Background="{StaticResource Surface3}" BorderThickness="0"/>
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"/>
                        </DockPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="16,12" Background="#241D16" BorderBrush="#51402B" BorderThickness="1"
                            Visibility="{Binding HasError, Converter={StaticResource VisIf}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T retry}" Command="{Binding RetryCommand}" Margin="16,0,0,0"/>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/>
                        </DockPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="16,12" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,8,0,0"
                            Visibility="{Binding State, Converter={StaticResource VisIf}, ConverterParameter=WaitingWake}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T retry}" Command="{Binding RetryCommand}" Margin="16,0,0,0"/>
                            <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding WakeHint}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <ContentControl Grid.Row="2" Content="{Binding}" Focusable="False"/>

                <Border Grid.Row="3" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="32,16"
                        Visibility="{Binding IsReady, Converter={StaticResource VisIf}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{l:T shell_apply_hint}" Foreground="{StaticResource Muted}" FontSize="11"
                                       Visibility="{Binding IsDirty, Converter={StaticResource VisIfNot}}"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsDirty, Converter={StaticResource VisIf}}">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Warn}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T pending_changes}" Foreground="{StaticResource Warn}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="11" MaxWidth="280"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{l:T discard}" Command="{Binding DiscardCommand}" Style="{StaticResource Ghost}" Margin="0,0,12,0"/>
                            <Button Style="{StaticResource Primary}" Command="{Binding ApplyCommand}" Padding="20,11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Foreground="White" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="{l:T apply}" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,20" CornerRadius="12"
                        Background="{StaticResource Surface3}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="18,12"
                        Visibility="{Binding Toast, Converter={StaticResource VisIf}}" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Success}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" MaxWidth="620"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <Grid Margin="16,22,16,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="2,0,2,30">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="64" Height="64" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SharkBaby" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="DRIVERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="1,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{l:T shell_brand_tagline}" FontSize="10" Foreground="{StaticResource Muted}" Margin="3,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="10,0,10,14">
                        <Border DockPanel.Dock="Right" Background="{StaticResource Surface2}" CornerRadius="5" Padding="7,2">
                            <TextBlock Text="{Binding Devices.Count}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{l:T shell_devices}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource NavItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceVm}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="40" CornerRadius="10" Background="{StaticResource Surface3}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NavigationTitle}" ToolTip="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"/>
                                        <TextBlock Text="{Binding LinkText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Success}" ToolTip="{l:T shell_connected}" Visibility="{Binding IsReady, Converter={StaticResource VisIf}}"/>
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" ToolTip="{l:T shell_loading}" Visibility="{Binding IsLoading, Converter={StaticResource VisIf}}"/>
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Warn}" ToolTip="{l:T shell_attention}" Visibility="{Binding HasError, Converter={StaticResource VisIf}}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,16,0,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE73F;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" FontSize="17" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="{l:T shell_background_title}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T shell_background_hint}" Style="{StaticResource Hint}" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Button Command="{Binding RefreshCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="{l:T refresh}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenBackupsCommand}" Style="{StaticResource Ghost}" HorizontalContentAlignment="Left" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="{l:T open_backups}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="2,14,2,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Language}"
                                      ToolTip="{l:T language}" FontSize="11" Padding="9,6"/>
                            <TextBlock Grid.Column="1" Text="{Binding Version, StringFormat=v{0}}" Foreground="{StaticResource Muted}" FontSize="10" Margin="12,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Selected}" ContentTemplate="{StaticResource DeviceShell}" Focusable="False"
                        Visibility="{Binding HasDevices, Converter={StaticResource VisIf}}"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390" Margin="32"
                    Visibility="{Binding HasDevices, Converter={StaticResource VisIfNot}}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="40" Width="180" Height="180" HorizontalAlignment="Center" Margin="0,0,0,28">
                <Image Source="pack://application:,,,/Assets/logo.png" Margin="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Text="{l:T shell_empty_hint}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{l:T no_devices_text}" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,12,0,24"/>
            <Button Content="{l:T refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Center" Padding="24,10"/>
        </StackPanel>
    </Grid>
</Window>
