<Application x:Class="SharkBabyDrivers.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SharkBabyDrivers.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <c:EqualsConverter x:Key="Eq"/>
            <c:NotConverter x:Key="Not"/>
            <c:VisibleIfConverter x:Key="VisIf"/>
            <c:VisibleIfConverter x:Key="VisIfNot" Invert="True"/>
            <c:HexToBrushConverter x:Key="HexBrush"/>
            <c:FormatConverter x:Key="Fmt"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
